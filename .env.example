# Optional configuration for the Mineflayer MCP server. All have sensible defaults.

# Comma-separated tool-group keys to disable (see README catalog), e.g. creative,villager,enchanting
MCP_DISABLE_GROUPS=

# Max characters returned by any single tool call (output is truncated past this).
MCP_CHARACTER_LIMIT=25000

# Size of the in-memory event ring buffer.
MCP_EVENT_BUFFER=1000

# Minimum spacing (ms) between pushed resource-update / log notifications.
MCP_THROTTLE_MS=250

# Radius (blocks) for proximity-filtered events (entity spawns, sounds).
MCP_PROXIMITY_RADIUS=32

# Default timeout (ms) for long-running actions when the caller omits one.
MCP_ACTION_TIMEOUT_MS=60000
